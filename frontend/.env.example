# Google OAuth Client ID (Get from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID)
# Authorized JavaScript origin: http://localhost:3000 (and your production domain)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Facebook OAuth App ID (Get from Meta for Developers -> Apps)
VITE_FACEBOOK_APP_ID=1084268923055419

# Backend API Base URL (Change to https://your-domain.com/api when deployed)
VITE_API_BASE_URL=http://localhost:5000/api
