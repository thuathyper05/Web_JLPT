PORT=5000

# Local PostgreSQL Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_local_password
DB_NAME=jlpt_n5

# Supabase / Production PostgreSQL (Connection String via URI)
# When deploying to Render + Supabase, set DATABASE_URL in Render Environment Variables
# DATABASE_URL=postgresql://postgres.xxxx:your_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# JWT Secret Key for Authentication
JWT_SECRET=your_jwt_secret_key_here

# Render External URL (Optional: used by keep-alive service to prevent Render 15-minute sleep)
# RENDER_EXTERNAL_URL=https://jlpt-n5-backend.onrender.com
